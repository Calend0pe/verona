<!DOCTYPE html>
<html>
<head>
<script>
.afyatextcolor {--cordetalhes: rgba(115, 50, 51, 1); --corfundo: rgba(44, 44, 44, 0.7); --corbordas: rgba(58, 58, 58, 1); --cortexto: rgba(204, 204, 204, 1);}

.afyatextcolumn {flex-direction: column;}

.afyatext{margin-left:122px;margin-top:-10px;height: 320px;width: 600px;background-size:cover;background-position: center;background-color:#555;background-blend-mode: multiply;}

.afyatext2{float:left;height: 70px;width: 70px;background-size:cover;border-radius: 100%; background-size: cover; position: relative; top:15px;left: 20px; outline: solid 1px rgb(199, 182, 98);outline-offset: 8px;background-color:rgb(199, 182, 98);background-blend-mode: multiply;margin-right:42px;overflow:clip;}.estetop{height: 100px;width: 564px; overflow:clip;background-size:120%;background-position: 100% 20%;background-color:#444;background-blend-mode: multiply;border:17px solid #222;outline:1px solid #333;}

.afyatextbottom{height: 100px;width: 564px; overflow:clip;background-size:120%;background-position: 100% 20%;background-color:#444;background-blend-mode: multiply;border:17px solid #222;outline:1px solid #333;}

.afyatextblock{height: 120px;width: 200px;background-color:#333;margin-top:10px;position:relative;top:1px;margin-left:200px;border:17px solid #222;outline:1px solid #333;}.estetxt {width:40px; height: auto;font-family: "Abril Fatface"; font-size: 20px; color: rgba(255, 255, 255, 0.8); letter-spacing: 2px; text-transform: uppercase; text-align: right; line-height:100%;position:relative; top: 0px; right:5px;word-break: break-all;border-right: 1px solid #eee;margin:5px; padding-right:4px;}

.afyatexttxt2 {width:115px; height: 80px; overflow:auto;padding: 5px; font-family: calibri; font-size: 8px; color: #fff; letter-spacing: 2px; text-transform: uppercase; text-align: justify; line-height: 100%;}.estetxt2::-webkit-scrollbar {width: 1px;}.estetxt2::-webkit-scrollbar-thumb {background: #eee;}

.afyatexttxt3 {width:180px; height: auto;font-family: "Abril Fatface"; font-size: 52px; color: rgba(255, 255, 255, 0.1); letter-spacing: 2px; text-transform: uppercase; text-align: right; line-height:100%;position:relative; top: -10px; right:-125px;word-break: break-all;margin:5px; padding-right:4px;transform: rotate(-45deg);}

.afyatexttxt4 {width:400px; height: auto;font-family: "Abril Fatface"; font-size: 30px; color: rgba(255, 255, 255, 1); letter-spacing: 2px; text-transform: uppercase; text-align: right; line-height:100%;position:relative; top: -380px; right:-60px;word-break: break-all;margin:5px; padding-right:4px;}

.afyatexttxt5 {width:300px; height: auto;font-family: "Inter", san-serif; font-size: 15px; color: rgba(255, 255, 255, 1); letter-spacing: 9.5px; text-transform: uppercase; text-align: right; line-height:100%;position:relative; top: -380px; right:-115px;font-style: oblique;}

.afyatexttextoli {position: relative;top:-17px;left:-2px;width:60px;height: 1px;font-family: calibri; font-size: 8px; color: rgb(199, 182, 98); letter-spacing: 2px; text-transform: uppercase; text-align: center; line-height: 20%;background: #333;}

.block {position: relative; left:55px;margin-top:10px;width: 100px;height: 10px;padding:8px;font-family: calibri; font-size: 8px; color: #fff; letter-spacing: 2px; text-transform: uppercase; text-align: center; line-height: 100%;border: solid 1px #eee;}

.afyatextcon {font-size:70px;color: #fff; position: relative; right: 50px; top:-440px;text-shadow: rgba(255,255,255,0.99) 0px 0px 10px;}.texto{height: 200px;width: 70px; position: relative; top:-70px;left: -20px; transition: 1s;font-size:50px;color: #fff; transform:none;background-color: transparent;padding:20px;} 

.afyatexttexto:hover{transform:translateY(18px);top:-25px;background-color: rgb(199, 182, 98);}
</script>
</head>
</html>
